DATABASE_URL="file:./dev.db"
GO_SERGIPE_ENABLED="true"
TERRITORY_AI_ENABLED="false"
AI_PROVIDER="openai-compatible"
AI_MODEL=""
AI_API_KEY=""
AI_GATEWAY_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
# The opportunity assistant can reuse AI_API_KEY/AI_MODEL/AI_BASE_URL when
# AI_PROVIDER=gemini-openai-compatible and TERRITORY_AI_ENABLED=true.
GEMINI_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_TIMEOUT_MS="10000"
# 256 output tokens keeps the request below the application safety budget.
GEMINI_MAX_OUTPUT_TOKENS="256"
# Must be explicitly confirmed after checking the key's billing/free-tier status in AI Studio.
GEMINI_FREE_TIER_CONFIRMED="false"
# Shared, persistent atomic counter. Upstash REST credentials stay server-side.
GEMINI_RATE_LIMIT_REDIS_URL=""
GEMINI_RATE_LIMIT_REDIS_TOKEN=""
# Optional aliases: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
GEMINI_USER_DAILY_LIMIT="5"
GEMINI_GLOBAL_DAILY_LIMIT="20"
GEMINI_GLOBAL_PER_MINUTE_LIMIT="2"
